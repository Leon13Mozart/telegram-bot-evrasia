:root { font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #171717; background:#f5f5f3; }
* { box-sizing:border-box; }
body { margin:0; background:#f5f5f3; }
button,input,select { font:inherit; }
.page { padding:18px; }
.app-card { max-width:1280px; margin:0 auto; background:#fff; border-radius:24px; padding:24px; box-shadow:0 8px 30px rgba(0,0,0,.06); }
.header,.settings-heading,.table-info { display:flex; align-items:center; justify-content:space-between; gap:16px; }
.logo { font-size:24px; font-weight:900; letter-spacing:.06em; }
.user-role { color:#777; font-weight:600; }
.app-tabs { display:flex; gap:8px; margin:22px 0; border-bottom:1px solid #eee; padding-bottom:10px; }
.app-tab,.date-button,.restaurant-button { border:1px solid #e2e2e2; background:#fff; border-radius:12px; padding:10px 14px; cursor:pointer; }
.app-tab.active,.date-button.active,.restaurant-button.active { background:#171717; color:#fff; border-color:#171717; }
.intro h1,.settings-heading h1 { margin:0 0 6px; font-size:28px; }
.intro p,.settings-heading p { margin:0; color:#777; }
.section-label { font-weight:700; margin:20px 0 10px; }
.dates,.restaurant-list { display:flex; gap:8px; flex-wrap:wrap; }
.assigned-restaurant { display:none; padding:12px 14px; background:#f5f5f5; border-radius:12px; }
body.admin .restaurant-list { display:none; }
body.admin .assigned-restaurant { display:flex; gap:8px; }
.search-section { margin:20px 0; }
.search-box { border:1px solid #ddd; border-radius:14px; padding:0 14px; display:flex; align-items:center; gap:8px; }
.search-box input { width:100%; border:0; outline:0; padding:13px 0; background:transparent; }
.table-info { margin:14px 0; }
.records-count { font-weight:700; }
.table-container,.settings-table-wrap { overflow:auto; border:1px solid #eee; border-radius:16px; }
table { width:100%; border-collapse:collapse; min-width:820px; }
th,td { text-align:left; padding:13px 12px; border-bottom:1px solid #eee; vertical-align:middle; }
th { background:#fafafa; font-size:13px; color:#666; position:sticky; top:0; z-index:1; }
.status-select { border:1px solid #ddd; border-radius:10px; padding:8px 10px; }
.empty-message,.error-message { padding:20px; text-align:center; color:#777; }
.error-message { color:#b42318; display:none; }
.footer { text-align:center; color:#777; margin-top:22px; }
.settings-view { margin-top:10px; }
.save-limits-button { border:0; background:#171717; color:#fff; border-radius:12px; padding:12px 18px; font-weight:700; cursor:pointer; }
.save-limits-button:disabled { opacity:.55; }
.settings-table-wrap { margin-top:18px; }
.limits-table { min-width:1000px; }
.limits-restaurant-col { min-width:230px; }
.limits-enabled-col { width:70px; text-align:center; }
.limits-enabled-cell { text-align:center; }
.limits-enabled-checkbox { width:20px; height:20px; }
.limit-input { width:90px; border:1px solid #d8d8d8; border-radius:10px; padding:9px; text-align:center; }
.limit-meta { margin-top:6px; font-size:11px; color:#777; white-space:nowrap; }
.settings-note { margin-top:14px; padding:12px 14px; background:#f7f7f7; border-radius:12px; color:#666; }
.settings-save-status { min-height:24px; margin-top:10px; font-weight:700; }
.settings-save-status.error { color:#b42318; }
.limits-empty { text-align:center; color:#777; }
@media (max-width:700px) { .page{padding:0}.app-card{border-radius:0;min-height:100vh;padding:16px}.header,.settings-heading{align-items:flex-start}.settings-heading{flex-direction:column}.intro h1,.settings-heading h1{font-size:23px}.save-limits-button{width:100%} }


/* Developer-only entry point for MK seat settings */
.developer-settings-entry[hidden], .settings-view[hidden] { display:none !important; }
.developer-settings-entry { margin:20px 0 6px; }
.developer-settings-button {
  width:100%; border:1px solid #efb817; background:#fff8df; color:#b67900;
  border-radius:16px; padding:14px 16px; display:flex; align-items:center; justify-content:center;
  gap:9px; font-weight:800; font-size:16px; cursor:pointer; box-shadow:0 2px 8px rgba(190,132,0,.08);
}
.developer-settings-button:active { transform:translateY(1px); }
.developer-settings-icon { font-size:19px; }
.settings-toolbar { margin-bottom:14px; }
.back-to-records-button {
  border:1px solid #e2e2e2; background:#fff; color:#333; border-radius:12px;
  padding:10px 14px; font-weight:700; cursor:pointer;
}
.settings-kicker { color:#b67900; font-size:13px; font-weight:900; text-transform:uppercase; letter-spacing:.05em; margin-bottom:6px; }
.settings-view { margin-top:18px; }
.save-limits-button { background:#f3b815; color:#171717; }
.limit-input:focus { outline:2px solid rgba(243,184,21,.35); border-color:#e6ad08; }

@media (max-width:700px) {
  .developer-settings-entry { margin:16px 0 4px; }
  .developer-settings-button { position:relative; min-height:50px; }
  .settings-view { margin-top:12px; }
  .settings-toolbar { position:sticky; top:0; z-index:3; padding:6px 0 10px; background:#fff; }
  .settings-table-wrap { border:0; overflow:visible; }
  .limits-table { min-width:0; display:block; }
  .limits-table thead { display:none; }
  .limits-table tbody { display:block; }
  .limits-table tr[data-group-id] { display:block; border:1px solid #ececec; border-radius:16px; padding:14px; margin-bottom:12px; background:#fff; }
  .limits-table td { display:block; border:0; padding:7px 0; }
  .limits-restaurant-name { font-weight:900; font-size:16px; padding-bottom:10px !important; }
  .limits-enabled-cell { text-align:left; display:flex !important; align-items:center; gap:8px; }
  .limits-enabled-cell::before { content:"Ресторан відкритий для запису"; font-weight:700; flex:1; }
  .limits-table td:has(.limit-input) { display:grid; grid-template-columns:82px minmax(0,1fr); column-gap:10px; align-items:center; border-top:1px solid #f0f0f0; padding:10px 0; }
  .limits-table td:has(.limit-input)::before { content:attr(data-date-label); font-weight:800; }
  .limit-input { width:100%; max-width:140px; justify-self:end; }
  .limit-meta { grid-column:1 / -1; margin-top:5px; }
  .settings-heading { gap:14px; }
}
